# AWS Region Configuration
AWS_REGION=us-east-1

# S3 Configuration Defaults
S3_BUCKET_NAME=my-learning-s3-bucket-unique-12345
S3_SOURCE_BUCKET=my-learning-s3-bucket-source-12345
S3_DEST_BUCKET=my-learning-s3-bucket-dest-12345
S3_OBJECT_KEY=sample.txt
LOCAL_FILE_PATH=examples/sample.txt
DOWNLOAD_PATH=downloads/downloaded_sample.txt

# Lambda Configuration Defaults
LAMBDA_FUNCTION_NAME=MySampleLambdaFunction
LAMBDA_ROLE_ARN=arn:aws:iam::123456789012:role/service-role/MyLambdaExecutionRole

# SECURITY NOTE:
# Never store AWS_ACCESS_KEY_ID or AWS_SECRET_ACCESS_KEY in this file.
# Use standard credential tools: `aws configure` or IAM Roles / Environment variables.
